{
  "name": "bb-plugin-workspaces",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Workspaces",
    "description": "Multi-root workspace aggregator: group existing bb projects into named workspaces and run one agent thread per folder.",
    "branding": {
      "icon": "Layers"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills"
    ]
  },
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "dev": "bb plugin dev ."
  }
}
