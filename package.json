{
  "name": "@grikomsn/bb-plugins",
  "version": "0.1.0",
  "description": "BB plugins that surface the Pi coding agent's third-party plugin (subagents, MCP, plannotator, codex-goal, unified-exec) event stream into the bb desktop app. Plus the companion pi extension that forwards events over a Unix socket.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck && npm run typecheck:pi",
    "typecheck:pi": "cd packages/pi-bb-bridge && tsc --noEmit",
    "build": "npm run --workspaces --if-present build",
    "patch:bridge": "node scripts/patch-pi-bridge.mjs",
    "unpatch:bridge": "node scripts/patch-pi-bridge.mjs --revert",
    "install:extension": "cp packages/pi-bb-bridge/index.ts \"$HOME/.pi/agent/extensions/pi-bb-bridge.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  }
}